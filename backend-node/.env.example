# ---- HTTP API ----
# Shared secret the frontend sends as the x-api-key header.
BACKEND_API_KEY=change-me
# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:5173,https://tg-tools-downlaod.vercel.app
PORT=8000

# ---- Supabase (service role, NEVER the anon key) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram userbot ----
# Preferred: keep these here instead of in the database.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Filled in after the first login; paste it back here to survive restarts.
TELEGRAM_SESSION_STRING=

# ---- Cloudflare R2 ----
# Optional overrides; by default these are read from the r2_settings table.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
R2_REGION=auto

# ---- Worker ----
# Seconds between background passes (downloads, auto rules, auto-forward).
WORKER_INTERVAL=30
# How many downloads may run at once (overrides download_settings when set).
MAX_CONCURRENT_DOWNLOADS=
# Where files are staged before the R2 upload. Windows example: D:\tg-downloads
DOWNLOAD_DIR=
